# Dependencies
node_modules/

# Build output
dist/
dist-admin/

# WASM artifacts (built locally by hush-crypto; do not commit)
src/wasm/

# Environment variables
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Coverage
coverage/

# Playwright
/playwright-report/
/test-results/
# E2E runtime state (PID file, compose override) -- generated by global-setup
e2e/media/.state/

# Local dev cert pair generated by mkcert. Never commit — these are
# specific to one developer's machine + LAN IPs and the matching
# private key would compromise the local CA if shared.
.certs/
